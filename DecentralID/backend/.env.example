# MongoDB Atlas Connection
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/ssi_auth?retryWrites=true&w=majority"
# Optional: overrides the database portion of MONGODB_URI (default: ssi_auth)
MONGODB_DB="ssi_auth"
# Optional: increase only if your network needs longer to reach Atlas.
MONGODB_SERVER_SELECTION_TIMEOUT_MS="30000"

# Authorized Administrator Credentials (Office of the Registrar Login)
ADMIN_EMAIL="registrar@example.edu"
ADMIN_PASSWORD="replace-with-a-unique-long-password"
ADMIN_ORG_NAME="Example University"

# Verifier Credentials (Verification Agency Login)
VERIFIER_ORG_ID="example-verifier"
VERIFIER_PASSWORD="replace-with-a-unique-long-password"
VERIFIER_ORG_NAME="Example Verification Agency"

# Security & Server
JWT_SECRET="replace-with-a-unique-random-secret-at-least-32-characters"
PORT=3000
NODE_ENV="development"

# ============================================================================
# Live Student Email Dispatch Configuration (Optional)
# If left empty, all enrollment & credential emails are simulated interactively
# in the on-screen UI modal without requiring an external mail server.
#
# To send REAL emails to student inboxes via Gmail:
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an App Name (e.g. "DecentralID") and generate a 16-letter App Password
# 4. Fill in SMTP_USER and SMTP_PASS below:
#    SMTP_PASS must be the newly generated 16-character App Password, not your
#    normal Gmail password. Restart the backend after changing this file.
# ============================================================================
SMTP_SERVICE="gmail"
SMTP_USER=""
SMTP_PASS=""
# "auto" sends through SMTP; "preview" never contacts an SMTP server.
EMAIL_MODE="auto"
EMAIL_FROM="MIT-ADT University Registrar <registrar@mituniversity.edu.in>"

# For custom SMTP servers (SendGrid, Mailgun, AWS SES, Hostinger, etc.):
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE=false
